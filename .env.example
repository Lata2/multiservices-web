# Copy to .env.local and adjust. Every VITE_* value is compiled into the
# public JS bundle, so never put secrets here.

# Public site URL (canonical links, Open Graph, sharing)
VITE_SITE_URL=https://servio.app

# true = in-memory mock backend with demo data; false = real API through src/services/http.ts
VITE_USE_MOCKS=true
VITE_API_URL=https://api.servio.app/v1
VITE_REQUEST_TIMEOUT_MS=20000
# Artificial latency (ms) for mock calls so loading states are visible. 0 disables it.
VITE_MOCK_LATENCY=450

# Social sign-in: demo = labelled demo-account picker, live = real Google / Apple
VITE_AUTH_MODE=demo
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_SIGN_IN=true
VITE_APPLE_SERVICE_ID=
VITE_APPLE_REDIRECT_URI=
# Dev only: lets the mock backend accept real ID tokens after checking claims (no signature check)
VITE_MOCK_ACCEPT_UNVERIFIED_ID_TOKENS=false

# Dev only: show the TanStack Query devtools button
VITE_QUERY_DEVTOOLS=false
